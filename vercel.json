{
  "regions": ["iad1"],
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/admin", "destination": "/api/admin/login.php", "permanent": false },
    { "source": "/admin/:path", "destination": "/api/admin/:path", "permanent": false }
  ]
}
